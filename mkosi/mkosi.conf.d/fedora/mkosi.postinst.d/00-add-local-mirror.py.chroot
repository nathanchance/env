#!/usr/bin/env python3

import json
import sys
from os import environ as env
from pathlib import Path

EXPECTED_MOUNTS: tuple[tuple[Path, str], ...] = (
    ((PYTHON_FOLDER := Path(env['SRCDIR'], 'python')), 'PYTHON_FOLDER'),
    ((ETC := Path(env['SRCDIR'], 'etc')), '/etc'),
)
for expected_path, host_value in EXPECTED_MOUNTS:
    if not expected_path.exists():
        msg = f"{host_value} not passed into build environment?"
        raise RuntimeError(msg)

sys.path.append(str(PYTHON_FOLDER))
from setup.fedora import setup_rpm_mirror  # ruff:ignore[module-import-not-at-top-of-file]

mkosi_json = json.loads(Path(env['MKOSI_CONFIG']).read_text(encoding='utf-8'))
if 'local-mirror' in mkosi_json['ImageId']:
    print('[+] Skipping creating repo override for local mirror image')
    sys.exit(0)

setup_rpm_mirror()
