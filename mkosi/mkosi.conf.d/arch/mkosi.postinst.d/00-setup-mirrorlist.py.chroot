#!/usr/bin/env python3

import sys
from os import environ as env
from pathlib import Path

EXPECTED_MOUNTS: tuple[tuple[Path, str], ...] = (
    ((PYTHON_FOLDER := Path(env['SRCDIR'], 'python')), 'PYTHON_FOLDER'),
)
for expected_path, host_value in EXPECTED_MOUNTS:
    if not expected_path.exists():
        msg = f"{host_value} not passed into build environment?"
        raise RuntimeError(msg)

sys.path.append(str(PYTHON_FOLDER))
from setup.arch import setup_mirrorlist  # ruff:ignore[module-import-not-at-top-of-file]

setup_mirrorlist()
