#!/usr/bin/env python3

import sys
from os import environ as env
from pathlib import Path

EXPECTED_MOUNTS: tuple[tuple[Path, str], ...] = (
    ((PYTHON_FOLDER := Path(env['SRCDIR'], 'python')), 'PYTHON_FOLDER'),
    ((ETC := Path(env['SRCDIR'], 'etc')), '/etc'),
)
for expected_path, host_value in EXPECTED_MOUNTS:
    if not expected_path.exists():
        msg = f"{host_value} not passed into build environment?"
        raise RuntimeError(msg)

sys.path.append(str(PYTHON_FOLDER))
from setup.arch import (  # ruff:ignore[module-import-not-at-top-of-file]
    LOCAL_MIRROR,
    add_local_mirror_to_repos,
)

if not (host_pacman_conf := Path(ETC, 'pacman.conf')).exists():
    sys.exit(0)  # host is not Arch, cannot be using local mirror

if LOCAL_MIRROR not in host_pacman_conf.read_text(encoding='utf-8'):
    sys.exit(0)  # host is Arch but still not using a local mirror

guest_pacman_conf = Path('/etc/pacman.conf')
guest_pacman_conf_txt = add_local_mirror_to_repos(guest_pacman_conf.read_text(encoding='utf-8'))
guest_pacman_conf.write_text(guest_pacman_conf_txt, encoding='utf-8')
