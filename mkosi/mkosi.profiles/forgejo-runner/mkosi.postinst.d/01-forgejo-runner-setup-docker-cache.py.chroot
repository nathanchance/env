#!/usr/bin/env python3

import json
from os import environ as env
from pathlib import Path

mkosi_json = json.loads(Path(env['MKOSI_CONFIG']).read_text(encoding='utf-8'))
if mkosi_json['Mirror']:
    print('[+] Configuring docker to use local registry')
    daemon_json = Path('/etc/docker/daemon.json')
    daemon_json_txt = """\
{
  "registry-mirrors": ["http://10.0.1.30:5003"]
}
"""
    if daemon_json.exists():
        msg = f"{daemon_json} already exists??"
        raise RuntimeError(msg)
    daemon_json.parent.mkdir(exist_ok=True, parents=True)
    daemon_json.write_text(daemon_json_txt, encoding='utf-8')
