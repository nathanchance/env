#!/usr/bin/env fish

if test "$DISTRIBUTION" != fedora
    echo "[+] Only relevant for Fedora, skipping..."
    return 0
end

# Install Docker using the latest Fedora release a base
if not set fedora_ver (python3 -c "import requests

print(
    max(
        {
            int(item['version'])
            for item
            in requests.get('https://fedoraproject.org/releases.json').json()
            if 'Beta' not in item['version']
        }
    )
)")
    return 1
end
dnf install \
    --enablerepo=docker-ce-stable \
    --releasever=$fedora_ver \
    -y \
    containerd.io \
    docker-ce \
    docker-ce-cli \
    docker-compose-plugin
or return
